    {
      "id": "CVE-2026-115560",
      "title": "Session upload progress with a runtime serialize_handler switch",
      "published": "2026-10-23",
      "status": "unconfirmed",
      "sources": ["php-net", "cert-eu", "rhsb-2026-013"],
      "note": "TODO: full advisory promised with the next regular release; no affected versions, fixed versions or CVSS yet. Requires session.serialize_handler set to php_binary or php_serialize, switched to php with ini_set() before session_start(), while session upload progress is enabled.",
      "mitigations": ["session-upload-progress-off"]
    }
  ],

  "mitigations": {
    "session-upload-progress-off": {
      "setting": "session.upload_progress.enabled",
      "type": "bool",
      "php_default": "1",
      "expect": { "op": "eq", "value": "0" },
      "early_only": true,
      "coverage": "partial",
      "status": "confirmed",
      "sources": ["ghsa-6wmf", "php-net", "rhsb-2026-013", "php-manual-ini"],
      "note": "Blocks the confirmed session paths only. Set in php.ini, an FPM pool or server config, then restart every worker; ini_set() and .user.ini do not count. Red Hat states it removes exposure to CVE-2026-109619 on the RHEL 7 php package and fully protects against CVE-2026-115560."
    },
    "fatal-error-backtraces-off": {
      "setting": "fatal_error_backtraces",
      "type": "bool",
      "php_default": "1",
      "expect": { "op": "eq", "value": "0" },
      "early_only": true,
      "branches": ["8.5"],
      "coverage": "partial",
      "status": "confirmed",
      "sources": ["ghsa-6wmf", "php-net", "php-manual-errorfunc"],
      "note": "Blocks the confirmed fatal backtrace path only. The setting exists from PHP 8.5.0."
    },
    "memory-limit-unlimited": {
      "setting": "memory_limit",
      "type": "size",
      "php_default": "128M",
      "expect": { "op": "eq", "value": "-1" },
      "early_only": true,
      "prefer_admin": true,
      "coverage": "partial",
      "status": "confirmed",
      "sources": ["php-net", "ghsa-w8hw", "rhsb-2026-013", "php-manual-ini"],
      "note": "Counter-intuitive: removes the controllable PHP memory limit failure. Set with php_admin_value so applications cannot put a finite limit back. Pair with a container or cgroup limit; never RLIMIT_AS or RLIMIT_DATA."
    },
    "post-max-size-low": {
      "setting": "post_max_size",
      "type": "size",
      "php_default": "8M",
      "expect": { "op": "lte", "value": "32M" },
      "early_only": true,
      "coverage": "partial",
      "status": "confirmed",
      "sources": ["php-net", "rhsb-2026-013", "php-manual-ini"],
      "note": "8M for applications without file uploads, 32M with them. Keep upload_max_filesize below post_max_size, and enforce request limits at the web server, including for requests without a usable Content-Length."
    }
  },

  "hardening": [
    {
      "id": "expose-php-off",
      "setting": "expose_php",
      "type": "bool",
      "expect": { "op": "eq", "value": "0" },
      "sources": [],
      "note": "General hardening, not from the advisories: hides the PHP version from response headers."
    },
    {
      "id": "max-input-nesting-level",
      "setting": "max_input_nesting_level",
      "type": "int",
      "sources": ["ghsa-w8hw"],
      "note": "The advisory recommends reducing it; nested field names are one multipart path to OOM. It gives no target value."
    },
    {
      "id": "max-input-vars",
      "setting": "max_input_vars",
      "type": "int",
      "sources": ["ghsa-w8hw"],
      "note": "The advisory recommends bounding input variables. It gives no target value."
    },
    {
      "id": "max-file-uploads",
      "setting": "max_file_uploads",
      "type": "int",
      "sources": ["ghsa-w8hw"],
      "note": "The advisory recommends bounding uploads; empty file controls are one multipart path to OOM. It gives no target value."
    },
    {
      "id": "upload-max-filesize",
      "setting": "upload_max_filesize",
      "type": "size",
      "sources": ["php-net"],
      "note": "Keep below post_max_size."
    }
  ]
